{
  "name": "knowledge-master-windows",
  "version": "0.2.0",
  "description": "KnowledgeMaster Windows desktop client",
  "main": "out/main/index.js",
  "author": "hkcao",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "npm run test && npm run typecheck && electron-vite build",
    "package": "npm run build && electron-builder --win nsis",
    "package:dir": "npm run build && electron-builder --win dir"
  },
  "dependencies": {
    "dompurify": "^3.2.3",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.0",
    "marked": "^15.0.6",
    "pdf-parse": "^1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.hkcao.knowledgemaster.windows",
    "productName": "KnowledgeMaster",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/pdf-parse/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "KnowledgeMaster-Windows-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
