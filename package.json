{
  "name": "knowledge-master",
  "productName": "KnowledgeMaster",
  "version": "0.1.0",
  "private": true,
  "author": "hkcao",
  "description": "本地优先的 AI 知识整理桌面应用",
  "main": "src/main/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack:mac": "electron-builder --mac dir --arm64",
    "build:mac": "electron-builder --mac dmg zip --arm64"
  },
  "dependencies": {
    "pdfjs-dist": "^5.4.296"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.hkcao.knowledgemaster",
    "productName": "KnowledgeMaster",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
