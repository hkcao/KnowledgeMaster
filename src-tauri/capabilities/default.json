  "identifier": "default",
  "description": "Default capability set for KnowledgeMaster",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "store:default",
    "stronghold:default",
    "shell:default",
