{
  "$schema": "https://raw.githubusercontent.com/nicepage/nicepage/HEAD/.schemas/tauri-conf.schema.json",
  "productName": "知屿",
  "version": "2.0.0",
  "identifier": "com.hkcao.knowledgemaster",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "知屿",
        "width": 1460,
        "height": 900,
        "minWidth": 900,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "targets": ["app", "dmg"]
  },
  "plugins": {
    "dialog": {},
    "store": {},
    "stronghold": {
      "timeout": 60000
    },
    "shell": {
      "open": true
    }
  }
}
